{
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tailwindcss --input resources/css/app.css --output resources/dist/filament-translatable.css --minify",
        "dev": "tailwindcss --input resources/css/app.css --output resources/dist/filament-translatable.css --watch",
        "format": "prettier --write resources/css resources/views",
        "lint": "prettier --check resources/css resources/views",
        "build-with-purge": "npm run build && npm run purge",
        "purge": "filament-purge -i resources/dist/filament-translatable.css -o resources/dist/filament-translatable.css -v 3.x"
    },
    "devDependencies": {
        "@awcodes/filament-plugin-purge": "^1.1.1",
        "@tailwindcss/cli": "^4.3.3",
        "prettier": "^3.9.7",
        "prettier-plugin-blade": "^2.1.21",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.1.11"
    }
}
